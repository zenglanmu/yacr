import { VerticalBox, HorizontalBox, CheckBox, ScrollView, LineEdit, TextEdit } from "std-widgets.slint";
import { Button } from "button.slint";
import { CadTheme } from "theme.slint";
export struct LayerRow { id: int, name: string, visible: bool, overridden: bool }
export struct PropertyRow { key: string, value: string }
export struct AnnotationRow { id: int, kind: string, text: string, visible: bool, overridden: bool, selected: bool }
export struct DiagnosticRow { code: string, severity: string, description: string, object: string, details: string }
export struct LayoutRow { id: int, name: string, supported: bool, reason: string, viewport_count: int }

// Scrollable dock/bottom sheet. Models are real adapter data, not sample rows.
export component CadPanels inherits Rectangle {
    in property <bool> phone;
    in property <bool> work;
    in property <[string]> labels;
    in property <[LayerRow]> layers;
    in property <string> layers-show-all-label;
    in property <string> layers-hide-all-label;
    // Search is presentation-only; never replace the authoritative layer model.
    // Hosts supply catalog text and the matching count for the no-results state.
    // -1 means the host has not supplied a count, not a successful empty search.
    in-out property <string> layer-search-text;
    in property <string> layer-search-placeholder: root.labels[0];
    in property <string> layer-search-clear-label;
    in property <string> layer-search-empty-label;
    in property <int> layer-matching-count: -1;
    in property <[PropertyRow]> properties;
    in property <[LayoutRow]> layouts;
    in property <[AnnotationRow]> annotations;
    in property <[DiagnosticRow]> diagnostics;
    in property <string> backend;
    in property <bool> diagnostics-open;
    in property <string> diagnostics-empty-label;
    in-out property <int> section: 0;
    callback close();
    callback restore();
    callback clear-selection();
    callback layer(int, bool);
    callback all-layers(bool);
    callback layer-search-edited(string);
    callback layout(int);
    callback annotation-select(int);
    callback annotation-delete(int);
    callback annotation-visible(int, bool);
    changed layer-search-text => { root.layer-search-edited(root.layer-search-text); }
    pure function layer-matches(name: string) -> bool {
        // Slint 1.18 has no string contains(); replacement provides substring
        // matching without experimental model APIs or a reindexed copy.
        root.layer-search-text == "" ||
            name.to-lowercase().replace-all(root.layer-search-text.to-lowercase(), "") != name.to-lowercase()
    }
    min-height: 0px; min-width: 0px;
    preferred-height: 210px;
    background: CadTheme.chrome;
    border-color: CadTheme.border; border-width: 1px;
    ScrollView {
        VerticalBox {
            padding: 6px; spacing: 6px; alignment: start;
            HorizontalBox {
                Text { text: root.diagnostics-open ? root.labels[12] : (root.section == 0 ? root.labels[0] : (root.section == 1 ? root.labels[6] : root.labels[9]));
                    color: CadTheme.ink; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                Button { text: root.labels[2]; symbol: "×"; icon-only: true; min-width: 48px; preferred-width: 48px;
                    min-height: 48px; clicked => { root.close(); } }
            }
            // Diagnostics replace the normal sections, retaining their state.
            if !root.diagnostics-open : VerticalBox {
            padding: 0px; spacing: 6px; alignment: start;
            HorizontalBox {
                alignment: start;
                Button { text: root.labels[0]; symbol: "layers"; icon-only: true; checked: root.section == 0; min-width: 48px; preferred-width: 48px;
                    min-height: 48px; clicked => { root.section = 0; } }
                Button { text: root.labels[6]; symbol: "i"; icon-only: true; checked: root.section == 1; min-width: 48px; preferred-width: 48px;
                    min-height: 48px; clicked => { root.section = 1; } }
                Button { text: root.labels[9]; symbol: "□"; icon-only: true; checked: root.section == 2; min-width: 48px; preferred-width: 48px;
                    min-height: 48px; clicked => { root.section = 2; } }
            }
            if root.section == 0 : Button { text: root.labels[1]; symbol: "layers"; enabled: root.layers.length > 0; min-height: 48px; clicked => { root.restore(); } }
            if root.section == 0 : HorizontalBox {
                padding: 0px; spacing: 4px;
                Button { text: root.layers-show-all-label; min-width: 0px; horizontal-stretch: 1;
                    min-height: 48px; enabled: root.layers.length > 0;
                    clicked => { root.all-layers(true); } }
                Button { text: root.layers-hide-all-label; min-width: 0px; horizontal-stretch: 1;
                    min-height: 48px; enabled: root.layers.length > 0;
                    clicked => { root.all-layers(false); } }
            }
            if root.section == 0 : HorizontalBox {
                padding: 0px; spacing: 4px;
                LineEdit {
                    min-width: 0px; horizontal-stretch: 1;
                    min-height: root.phone ? 48px : 36px;
                    enabled: root.layers.length > 0 || root.layer-search-text != "";
                    placeholder-text: root.layer-search-placeholder;
                    accessible-label: root.layer-search-placeholder;
                    text <=> root.layer-search-text;
                }
                if root.layer-search-clear-label != "" : Button {
                    text: root.layer-search-clear-label; symbol: "×"; icon-only: true;
                    min-width: 48px; preferred-width: 48px;
                    min-height: root.phone ? 48px : 36px;
                    enabled: root.layer-search-text != "";
                    clicked => { root.layer-search-text = ""; }
                }
            }
            if root.section == 0 && root.layers.length == 0 : Text { text: root.labels[3]; color: CadTheme.muted; wrap: word-wrap; }
            if root.section == 0 && root.layers.length > 0 && root.layer-search-text != "" && root.layer-matching-count == 0 && root.layer-search-empty-label != "" : Text {
                text: root.layer-search-empty-label; color: CadTheme.muted; wrap: word-wrap;
            }
            if root.section == 0 : VerticalBox {
            padding: 0px; spacing: 0px;
            // Keep the original model index even when earlier rows are hidden.
            // A conditional child collapses nonmatches instead of leaving gaps.
            for row[index] in root.layers : VerticalBox {
                padding: 0px; spacing: 0px;
                if root.layer-matches(row.name) : CheckBox {
                    min-height: root.phone ? 48px : 36px;
                    text: row.name; checked: row.visible;
                    toggled => { root.layer(index, self.checked); }
                }
            }
            }
            if root.section == 1 : VerticalBox {
            padding: 0px;
            HorizontalBox {
                Text { text: root.labels[6]; color: CadTheme.accent; }
                Button { text: root.labels[7]; symbol: "×"; enabled: root.properties.length > 0; min-height: 48px; clicked => { root.clear-selection(); } }
            }
            if root.properties.length == 0 : Text { text: root.labels[8]; color: CadTheme.muted; wrap: word-wrap; }
            for row in root.properties : VerticalBox {
                padding: 0px; spacing: 4px;
                Text { text: row.key; color: CadTheme.ink; wrap: word-wrap; }
                // Keep the complete adapter value, including mixed-state text.
                // The standard editor supports selection, Ctrl+C and scrolling
                // while read-only prevents keyboard/paste changes to the value.
                TextEdit {
                    min-width: 0px; horizontal-stretch: 1; vertical-stretch: 0;
                    min-height: 48px; preferred-height: root.phone ? 96px : 72px;
                    text: row.value;
                    read-only: true; enabled: true; wrap: word-wrap;
                    accessible-label: row.key;
                    // Ignore writes without replacing the live model binding.
                    accessible-action-set-value(value) => { }
                }
            }
            }
            if root.section == 2 : VerticalBox {
            padding: 0px;
            Text { text: root.labels[9]; color: CadTheme.accent; }
            if root.annotations.length == 0 : Text { text: root.labels[10]; color: CadTheme.muted; }
            for row[index] in root.annotations : HorizontalBox {
                Button { text: row.kind + (row.selected ? " *" : ""); min-height: 48px; clicked => { root.annotation-select(index); } }
                Text { text: row.text; color: CadTheme.ink; overflow: elide; horizontal-stretch: 1; }
                CheckBox { checked: row.visible; enabled: root.work; toggled => { root.annotation-visible(index, self.checked); } }
                Button { text: root.labels[11]; symbol: "×"; min-height: 48px; enabled: root.work; clicked => { root.annotation-delete(index); } }
            }
            }
            }
            if root.diagnostics-open : Text { text: root.backend; color: CadTheme.ink; wrap: word-wrap; }
            if root.diagnostics-open && root.diagnostics.length == 0 : Text {
                text: root.diagnostics-empty-label; color: CadTheme.muted; wrap: word-wrap;
            }
            if root.diagnostics-open : VerticalBox {
                padding: 0px; spacing: 6px;
                // Preserve all semantic fields, including object attribution.
                // Newlines separate supplied data without invented field prose.
                for row in root.diagnostics : TextEdit {
                    min-width: 0px; horizontal-stretch: 1; vertical-stretch: 0;
                    min-height: 96px; preferred-height: root.phone ? 180px : 144px;
                    text: row.severity + "\n" + row.code + "\n" + row.description + "\n" + row.object + "\n" + row.details;
                    read-only: true; enabled: true; wrap: word-wrap;
                    accessible-label: row.code;
                    accessible-action-set-value(value) => { }
                }
            }
        }
    }
}
