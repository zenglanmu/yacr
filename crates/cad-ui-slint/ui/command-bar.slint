import { HorizontalBox, VerticalBox, LineEdit, TextEdit, ScrollView } from "std-widgets.slint";
import { Button } from "button.slint";
import { CadTheme } from "theme.slint";

export component CadCommandBar inherits Rectangle {
    in property <bool> phone;
    in property <string> title;
    in property <string> prompt;
    in property <string> status;
    in property <string> open-label;
    in property <bool> can-open: true;
    in property <string> tools-label;
    in property <string> fit-label;
    in property <string> mode-label;
    in property <bool> mode-work;
    // Host-owned submitted command text, not command output or diagnostics.
    in property <[string]> history-entries;
    in property <string> history-label;
    in property <string> clear-history-label;
    in property <bool> history-storage-limited;
    in property <string> history-limit-label;
    in property <bool> keyboard-shortcuts-enabled: false;
    // The host supplies ranked selectors and owns dismissal, including Escape.
    in property <[string]> completion-items;
    in property <string> completion-label;
    // -1 means no keyboard highlight. A refreshed model never retains a stale row.
    private property <int> selected-completion-index: -1;
    private property <length> completion-scroll-y: 0px;
    changed completion-items => {
        root.selected-completion-index = -1;
        root.completion-scroll-y = 0px;
    }
    changed selected-completion-index => {
        // Three suggestion rows are visible; keep keyboard highlighting in view.
        root.completion-scroll-y = -max(0, root.selected-completion-index - 2)
            * (root.phone ? 48px : 36px);
    }
    in-out property <bool> expanded: false;
    property <string> input;
    callback input-edited(string);
    // Observe all text changes, including history recall and completion fills.
    changed input => { root.input-edited(root.input); }
    callback open();
    callback tools();
    callback fit();
    callback mode-toggled();
    // Returns true when the host consumed/cleared the line, false when it kept
    // the input open (for example an ambiguous prefix that needs disambiguation).
    callback submit(string) -> bool;
    // The host owns the cursor and draft: -1 is older, +1 is newer.
    callback recall(int, string) -> string;
    callback clear-history();
    height: root.expanded ? (root.phone ? 304px : 280px) : (root.phone ? 64px : 58px);
    background: CadTheme.chrome;
    VerticalBox {
        padding: 6px; spacing: 4px;
        if root.expanded : Text { text: root.status; color: CadTheme.muted; overflow: elide; height: 24px; }
        HorizontalBox {
            padding: 0px;
            spacing: 4px;
            Button { text: root.open-label; symbol: "▱"; enabled: root.can-open; min-height: root.phone ? 48px : 36px; clicked => { root.open(); } }
            // On phones the mode toggle lives in the expandable row so it cannot
            // squeeze the command input on a 320px screen; on wide layouts it is
            // a primary-row control.
            if !root.phone : Button { text: root.mode-label; checked: root.mode-work; min-height: 36px; clicked => { root.mode-toggled(); } }
            if !root.phone : Text { text: root.title; color: CadTheme.ink; vertical-alignment: center; }
            FocusScope {
                min-width: 0px;
                horizontal-stretch: 1;
                min-height: root.phone ? 48px : 36px;
                forward-focus: command-input;
                // Only the command editor owns this capture, not archive TextEdits.
                // Modified keys and local editing shortcuts still reach LineEdit.
                capture-key-pressed(event) => {
                    if !root.keyboard-shortcuts-enabled || event.modifiers.control
                        || event.modifiers.alt || event.modifiers.meta || event.modifiers.shift {
                        return EventResult.reject;
                    }
                    if event.text == Key.UpArrow {
                        if root.completion-items.length > 0 {
                            root.selected-completion-index = root.selected-completion-index < 0
                                ? root.completion-items.length - 1
                                : max(0, min(root.selected-completion-index - 1, root.completion-items.length - 1));
                        } else {
                            root.input = root.recall(-1, root.input);
                        }
                        return EventResult.accept;
                    }
                    if event.text == Key.DownArrow {
                        if root.completion-items.length > 0 {
                            root.selected-completion-index = min(root.selected-completion-index + 1, root.completion-items.length - 1);
                        } else {
                            root.input = root.recall(1, root.input);
                        }
                        return EventResult.accept;
                    }
                    // Tab fills the highlight or first row, never submits.
                    if event.text == Key.Tab && root.completion-items.length > 0 {
                        root.input = root.completion-items[max(0, min(root.selected-completion-index, root.completion-items.length - 1))];
                        root.selected-completion-index = -1;
                        command-input.focus();
                        return EventResult.accept;
                    }
                    // A highlighted completion plus Space fills the selector
                    // (never submits) so multi-word names like ZOOM EXTENTS can be
                    // completed; without a highlight the space reaches LineEdit.
                    if event.text == " " && root.selected-completion-index >= 0
                        && root.selected-completion-index < root.completion-items.length {
                        root.input = root.completion-items[root.selected-completion-index];
                        root.selected-completion-index = -1;
                        command-input.focus();
                        return EventResult.accept;
                    }
                    // Return with a highlighted completion executes that selector;
                    // the host decides whether the line is cleared.
                    if event.text == Key.Return && root.selected-completion-index >= 0
                        && root.selected-completion-index < root.completion-items.length {
                        root.input = root.completion-items[root.selected-completion-index];
                        root.selected-completion-index = -1;
                        if root.submit(root.input) {
                            root.input = "";
                        } else {
                            command-input.focus();
                        }
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }
                command-input := LineEdit {
                    width: parent.width;
                    height: parent.height;
                    placeholder-text: root.prompt;
                    accessible-label: root.prompt;
                    text <=> root.input;
                    accepted => { if root.submit(root.input) { root.input = ""; } }
                }
            }
            Button { text: root.expanded ? "v" : "^"; min-width: 48px; preferred-width: 48px; min-height: root.phone ? 48px : 36px; clicked => { root.expanded = !root.expanded; } }
        }
        if root.expanded : HorizontalBox {
            padding: 0px;
            if root.phone : Button { text: root.mode-label; checked: root.mode-work; min-height: 48px; clicked => { root.mode-toggled(); } }
            Button { text: root.tools-label; min-height: 48px; clicked => { root.tools(); } }
            Button { text: root.fit-label; min-height: 48px; clicked => { root.fit(); } }
        }
        if root.expanded : HorizontalBox {
            padding: 0px; spacing: 4px;
            Text {
                text: root.history-label;
                color: CadTheme.muted;
                min-width: 0px;
                horizontal-stretch: 1;
                vertical-alignment: center;
                overflow: elide;
            }
            Button {
                text: root.clear-history-label;
                symbol: "×"; icon-only: true;
                min-width: 48px; preferred-width: 48px;
                min-height: root.phone ? 48px : 36px;
                enabled: root.history-entries.length > 0;
                clicked => { root.clear-history(); }
            }
        }
        if root.expanded : ScrollView {
            height: 104px;
            min-width: 0px;
            VerticalBox {
                padding: 0px; spacing: 4px; alignment: start;
                if root.history-storage-limited : Text {
                    text: root.history-limit-label;
                    color: CadTheme.muted; wrap: word-wrap;
                }
                // Each submitted command is selectable/copyable independently.
                // Long entries scroll within their editor; the archive scrolls
                // across entries without growing the command bar.
                for entry in root.history-entries : TextEdit {
                    text: entry;
                    read-only: true;
                    // A read-only archive must also ignore accessibility writes.
                    accessible-action-set-value(value) => { }
                    accessible-label: root.history-label;
                    min-width: 0px;
                    height: 48px;
                    wrap: word-wrap;
                }
            }
        }
    }
    // Overlay above the bar without resizing or displacing the history archive.
    // Full bar width keeps selectors usable on a 320px phone viewport.
    if root.completion-items.length > 0 : Rectangle {
        x: 0px;
        y: -self.height;
        width: root.width;
        height: 40px + min(3, root.completion-items.length) * (root.phone ? 48px : 36px);
        background: CadTheme.chrome;
        border-color: CadTheme.border;
        border-width: 1px;
        VerticalBox {
            padding: 6px; spacing: 4px;
            Text {
                text: root.completion-label;
                color: CadTheme.muted;
                height: 24px;
                min-width: 0px;
                overflow: elide;
            }
            completion-scroll := ScrollView {
                content-y <=> root.completion-scroll-y;
                min-width: 0px;
                height: min(3, root.completion-items.length) * (root.phone ? 48px : 36px);
                VerticalBox {
                    padding: 0px; spacing: 0px; alignment: start;
                    for selector[index] in root.completion-items : Button {
                        text: selector;
                        accessible-label: root.completion-label + " " + selector;
                        checked: index == root.selected-completion-index;
                        accessible-checkable: true;
                        accessible-checked: self.checked;
                        min-width: 0px;
                        horizontal-stretch: 1;
                        min-height: root.phone ? 48px : 36px;
                        preferred-height: root.phone ? 48px : 36px;
                        clicked => {
                            root.input = selector;
                            root.selected-completion-index = -1;
                            command-input.focus();
                        }
                    }
                }
            }
        }
    }
}
