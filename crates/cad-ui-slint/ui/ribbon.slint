import { HorizontalBox, VerticalBox, ComboBox, ScrollView } from "std-widgets.slint";
import { Button } from "button.slint";
import { CadTheme } from "theme.slint";
import { RibbonTabModel } from "ribbon-model.slint";

// Stable action IDs are mapped to the shared command callbacks at the shell boundary.
export component CadRibbon inherits Rectangle {
    in property <bool> phone;
    in property <bool> compact;
    in property <length> target: 36px;
    in property <[string]> tabs;
    in property <[RibbonTabModel]> config-tabs;
    in property <bool> config-driven: false;
    // Catalog label for the group overflow affordance ("more"). A host with
    // custom tabs plumbs it through; the fallback keeps the built-in catalog.
    in property <string> overflow-label;
    // Index of the group whose overflow flyout is open within the active tab,
    // or -1 when none is open. A single property replaces per-group state,
    // which Slint cannot hold across a `for` loop.
    in-out property <int> overflow-open-group: -1;
    // Host-independent cap on the command buttons a group shows before it
    // collapses the remainder into the overflow flyout.
    property <int> max-commands: 6;
    // Origin of the open overflow button, recorded relative to this ribbon's
    // root. The floating flyout is anchored here (Slint positions a popup
    // relative to the element that declares it, not to the window), so the
    // ribbon row itself never grows.
    in-out property <length> overflow-anchor-x: 0px;
    in-out property <length> overflow-anchor-y: 0px;
    // Width of the floating flyout list.
    property <length> overflow-width: 200px;
    // Mirrors the flyout's own open state. Read here (the enclosing component)
    // because a PopupWindow's `is-open` is only observable from the component
    // that declares it; the runtime keeps this in sync on every close path.
    property <bool> overflow-flyout-open: overflow-flyout.is-open;
    // An outside click / Escape closes the popup without touching our index, so
    // reset the ribbon's open-group when the flyout reports it is gone.
    changed overflow-flyout-open => {
        if !root.overflow-flyout-open {
            root.overflow-open-group = -1;
        }
    }
    in property <[string]> labels;
    in property <[string]> measurements;
    in property <[string]> standard-views;
    in property <[string]> backends;
    in property <int> backend-index;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> view-3d;
    in property <bool> work-mode;
    in property <bool> can-open: true;
    in property <bool> can-import: true;
    in property <bool> can-export: true;
    in property <bool> can-trim: true;
    in property <bool> can-switch-backend: true;
    in property <string> draw-status;
    in property <[string]> editing-labels;
    in-out property <bool> expanded: true;
    in-out property <int> tab: 2;
    callback action(int);
    callback standard-view(string);
    callback backend(string);
    callback draw-tool(string);
    callback measure-kind(string);
    callback ribbon-command(string);
    // Clamp the active tab index for the configured list; the Rust side resets
    // it to 0 when a config-driven model is pushed, but the phone shortcuts can
    // still set an out-of-range index.
    property <int> config-tab-index: root.config-tabs.length == 0 ? 0 :
        (root.tab < 0 ? 0 : (root.tab >= root.config-tabs.length ? root.config-tabs.length - 1 : root.tab));
    height: root.phone ? (root.tab == 3 ? 148px : 112px) : (root.expanded ? 144px : 36px);
    background: CadTheme.chrome;
    border-color: CadTheme.border; border-width: 1px;
    VerticalBox {
        padding: 0px; spacing: 0px;
        if !root.phone : ScrollView {
            height: root.phone ? 52px : 36px;
            HorizontalBox {
                padding: 0px; spacing: 0px; alignment: start;
                for label[index] in root.tabs : Rectangle {
                    width: root.phone ? 70px : 96px;
                    background: root.tab == index ? #3f3f3f : #00000000;
                    Text { text: label; color: root.tab == index ? CadTheme.accent : CadTheme.ink;
                        horizontal-alignment: center; vertical-alignment: center; }
                    if root.tab == index : Rectangle { y: parent.height - 3px; height: 3px; x: 10px; width: parent.width - 20px; background: CadTheme.accent; }
                    TouchArea { clicked => { root.tab = index; root.expanded = true; } }
                }
                Button { text: root.labels[5]; symbol: root.expanded ? "⌃" : "⌄"; icon-only: true;
                    min-width: 48px; preferred-width: 48px; clicked => { root.expanded = !root.expanded; } }
            }
        }
        if root.expanded : ScrollView {
            VerticalBox {
                padding: 8px; spacing: 6px; alignment: start;
                // Host-configured tabs/groups/commands. Labels are already
                // localized by the adapter; clicking dispatches the real id.
                if root.config-driven : HorizontalBox {
                    alignment: start; spacing: 12px;
                    for tab-model[tab-index] in root.config-tabs : HorizontalBox {
                        visible: tab-index == root.config-tab-index;
                        alignment: start; spacing: 12px;
                        for group[group-index] in tab-model.groups : VerticalBox {
                            alignment: start; spacing: 4px;
                            Text {
                                text: group.label; color: CadTheme.muted; font-size: 12px;
                                horizontal-alignment: left; vertical-alignment: center;
                            }
                            // The model already filters hidden commands; the
                            // `visible` flag is kept on the row for completeness.
                            HorizontalBox {
                                alignment: start; spacing: 4px;
                                for command[command-index] in group.commands : Button {
                                    // Cap the inline buttons; the remainder is
                                    // reachable through the floating overflow
                                    // flyout, never dropped.
                                    visible: command.visible && command-index < root.max-commands;
                                    // `display`: 0 = icon + label, 1 = icon only,
                                    // 2 = label only. `icon-only` keeps the icon
                                    // and suppresses text; an empty symbol with
                                    // `stacked` keeps the text without an icon.
                                    text: command.display == 1 ? "" : command.label;
                                    symbol: command.display == 2 ? "" : command.icon;
                                    icon-only: command.display == 1;
                                    stacked: true;
                                    min-height: 76px;
                                    clicked => { root.ribbon-command(command.id); }
                                }
                                // Overflow affordance only when the group really
                                // has more commands than fit.
                                if group.commands.length > root.max-commands : Button {
                                    text: root.overflow-label; symbol: "▾";
                                    stacked: true; min-height: 76px;
                                    clicked => {
                                        if root.overflow-open-group == group-index {
                                            root.overflow-open-group = -1;
                                            overflow-flyout.close();
                                        } else {
                                            // Anchor the floating flyout under
                                            // this button. `absolute-position`
                                            // is window-relative, so subtract
                                            // the ribbon root to get an origin
                                            // relative to the declaring element.
                                            root.overflow-anchor-x =
                                                self.absolute-position.x - root.absolute-position.x;
                                            root.overflow-anchor-y =
                                                self.absolute-position.y - root.absolute-position.y + self.height;
                                            root.overflow-open-group = group-index;
                                            overflow-flyout.show();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if !root.config-driven && root.tab == 0 : HorizontalBox {
                    alignment: start;
                    Button { text: root.labels[0]; symbol: "▱"; enabled: root.can-open; stacked: true; min-height: 76px; clicked => { root.action(0); } }
                    Button { text: root.labels[9]; symbol: "⇧"; enabled: root.can-export; stacked: true; min-height: 76px; clicked => { root.action(10); } }
                    Button { text: root.labels[10]; symbol: "⇩"; enabled: root.can-import && root.work-mode; stacked: true; min-height: 76px; clicked => { root.action(11); } }
                }
                if !root.config-driven && root.tab == 1 : HorizontalBox {
                    alignment: start;
                    Button { text: root.labels[1]; symbol: "⊡"; stacked: true; min-height: 76px; clicked => { root.action(1); } }
                    Button { text: root.labels[6]; symbol: "▱"; stacked: true; checked: !root.view-3d; min-height: 76px; clicked => { root.action(7); } }
                    Button { text: root.labels[7]; symbol: "◇"; stacked: true; checked: root.view-3d; min-height: 76px; clicked => { root.action(8); } }
                    VerticalBox {
                        ComboBox { model: root.standard-views; enabled: root.view-3d; min-height: root.target; selected(value) => { root.standard-view(value); } }
                        Button { text: root.labels[8]; symbol: "◇"; enabled: root.view-3d; min-height: root.target; clicked => { root.action(9); } }
                    }
                }
                if !root.config-driven && root.tab == 2 : HorizontalBox {
                    alignment: start; spacing: 8px;
                    for label[index] in root.measurements : Button {
                        text: label; symbol: index == 0 ? "↔" : (index == 1 ? "∿" : (index == 2 ? "∠" : "▨"));
                        stacked: true; min-height: 76px; enabled: root.work-mode;
                        clicked => { root.measure-kind(label); }
                    }
                }
                if !root.config-driven && root.tab == 3 : VerticalBox {
                    HorizontalBox {
                        alignment: start;
                        Button { text: root.labels[5]; symbol: "layers"; min-height: root.target; clicked => { root.action(6); } }
                        Button { text: root.labels[11]; symbol: "info"; min-height: root.target; clicked => { root.action(12); } }
                        ComboBox { model: root.backends; enabled: root.can-switch-backend; current-index: root.backend-index; min-height: root.target; selected(value) => { root.backend(value); } }
                    }
                    HorizontalBox {
                        alignment: start;
                        for label[index] in root.editing-labels : Button {
                            text: label; symbol: index == 0 ? "line" : (index == 1 ? "circle" : (index == 2 ? "pan" : "trim"));
                            stacked: true; min-height: 76px; enabled: root.work-mode && (index != 3 || root.can-trim);
                            clicked => { root.draw-tool(label); }
                        }
                    }
                }
            }
        }
    }
    // Floating overflow flyout. Declared as a direct child of the ribbon root
    // so Slint anchors its x/y to the ribbon's origin (see `show_popup`: the
    // popup offsets by the declaring element's origin). It renders in its own
    // child window/top-level surface, so opening it never changes the ribbon
    // row height and it floats over the canvas like an AutoCAD flyout.
    overflow-flyout := PopupWindow {
        x: root.overflow-anchor-x;
        y: root.overflow-anchor-y;
        width: root.overflow-width;
        height: overflow-list-content.preferred-height;
        close-policy: close-on-click-outside;
        overflow-list := Rectangle {
            background: CadTheme.chrome;
            border-color: CadTheme.border;
            border-width: 1px;
            overflow-list-content := VerticalBox {
                padding: 4px; spacing: 2px; alignment: start;
                // The flyout reflects the active tab and the single open group.
                for tab-model[tab-index] in root.config-tabs : VerticalBox {
                    if tab-index == root.config-tab-index : VerticalBox {
                        for group[group-index] in tab-model.groups : VerticalBox {
                            if group-index == root.overflow-open-group : VerticalBox {
                                // Header: localized group label + a glyph-only
                                // close affordance (reuses the catalog label,
                                // adds no literal).
                                HorizontalBox {
                                    alignment: start; spacing: 4px;
                                    Text {
                                        text: group.label; color: CadTheme.muted; font-size: 12px;
                                        vertical-alignment: center; horizontal-stretch: 1;
                                    }
                                    Button {
                                        text: ""; symbol: "×"; icon-only: true;
                                        min-height: 24px; min-width: 24px; preferred-width: 24px;
                                        clicked => { overflow-flyout.close(); }
                                    }
                                }
                                for command[command-index] in group.commands : Button {
                                    visible: command.visible && command-index >= root.max-commands;
                                    text: command.display == 1 ? "" : command.label;
                                    symbol: command.display == 2 ? "" : command.icon;
                                    icon-only: command.display == 1;
                                    stacked: true; min-height: 76px;
                                    clicked => {
                                        root.ribbon-command(command.id);
                                        overflow-flyout.close();
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
