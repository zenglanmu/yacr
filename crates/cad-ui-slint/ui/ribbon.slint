import { HorizontalBox, VerticalBox, ComboBox, ScrollView } from "std-widgets.slint";
import { Button } from "button.slint";
import { CadTheme } from "theme.slint";

// Stable action IDs are mapped to the shared command callbacks at the shell boundary.
export component CadRibbon inherits Rectangle {
    in property <bool> phone;
    in property <bool> compact;
    in property <length> target: 36px;
    in property <[string]> tabs;
    in property <[string]> labels;
    in property <[string]> measurements;
    in property <[string]> annotations;
    in property <[string]> standard-views;
    in property <[string]> backends;
    in property <int> backend-index;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> view-3d;
    in property <bool> work-mode;
    in property <bool> can-open: true;
    in property <bool> can-import: true;
    in property <bool> can-export: true;
    in property <bool> can-trim: true;
    in property <bool> can-switch-backend: true;
    in property <string> draw-status;
    in property <[string]> editing-labels;
    in-out property <bool> expanded: true;
    in-out property <int> tab: 2;
    callback action(int);
    callback standard-view(string);
    callback backend(string);
    callback draw-tool(string);
    callback measure-kind(string);
    callback annotation-kind(string);
    height: root.phone ? (root.tab == 4 ? 148px : 112px) : (root.expanded ? 144px : 36px);
    background: CadTheme.chrome;
    border-color: CadTheme.border; border-width: 1px;
    VerticalBox {
        padding: 0px; spacing: 0px;
        if !root.phone : ScrollView {
            height: root.phone ? 52px : 36px;
            HorizontalBox {
                padding: 0px; spacing: 0px; alignment: start;
                for label[index] in root.tabs : Rectangle {
                    width: root.phone ? 70px : 96px;
                    background: root.tab == index ? #f4f7fa : #00000000;
                    Text { text: label; color: root.tab == index ? CadTheme.accent : CadTheme.ink;
                        horizontal-alignment: center; vertical-alignment: center; }
                    if root.tab == index : Rectangle { y: parent.height - 3px; height: 3px; x: 10px; width: parent.width - 20px; background: CadTheme.accent; }
                    TouchArea { clicked => { root.tab = index; root.expanded = true; } }
                }
                Button { text: root.labels[6]; symbol: root.expanded ? "⌃" : "⌄"; icon-only: true;
                    min-width: 48px; preferred-width: 48px; clicked => { root.expanded = !root.expanded; } }
            }
        }
        if root.expanded : ScrollView {
            VerticalBox {
                padding: 8px; spacing: 6px; alignment: start;
                if root.tab == 0 : HorizontalBox {
                    alignment: start;
                    Button { text: root.labels[0]; symbol: "▱"; enabled: root.can-open; stacked: true; min-height: 76px; clicked => { root.action(0); } }
                    Button { text: root.labels[10]; symbol: "⇧"; enabled: root.can-export; stacked: true; min-height: 76px; clicked => { root.action(10); } }
                    Button { text: root.labels[11]; symbol: "⇩"; enabled: root.can-import && root.work-mode; stacked: true; min-height: 76px; clicked => { root.action(11); } }
                }
                if root.tab == 1 : HorizontalBox {
                    alignment: start;
                    Button { text: root.labels[1]; symbol: "⊡"; stacked: true; min-height: 76px; clicked => { root.action(1); } }
                    Button { text: root.labels[7]; symbol: "▱"; stacked: true; checked: !root.view-3d; min-height: 76px; clicked => { root.action(7); } }
                    Button { text: root.labels[8]; symbol: "◇"; stacked: true; checked: root.view-3d; min-height: 76px; clicked => { root.action(8); } }
                    VerticalBox {
                        ComboBox { model: root.standard-views; enabled: root.view-3d; min-height: root.target; selected(value) => { root.standard-view(value); } }
                        Button { text: root.labels[9]; symbol: "◇"; enabled: root.view-3d; min-height: root.target; clicked => { root.action(9); } }
                    }
                }
                if root.tab == 2 : HorizontalBox {
                    alignment: start; spacing: 8px;
                    for label[index] in root.measurements : Button {
                        text: label; symbol: index == 0 ? "↔" : (index == 1 ? "∿" : (index == 2 ? "∠" : "▨"));
                        stacked: true; min-height: 76px; enabled: root.work-mode;
                        clicked => { root.measure-kind(label); }
                    }
                    if !root.phone : Rectangle { width: 1px; background: CadTheme.border; }
                    if !root.phone : Button { text: root.labels[5]; symbol: "A"; stacked: true; min-height: 76px; enabled: root.work-mode; clicked => { root.tab = 3; } }
                }
                if root.tab == 3 : HorizontalBox {
                    alignment: start; spacing: 8px;
                    for label[index] in root.annotations : Button {
                        text: label; symbol: index == 0 ? "A" : (index == 1 ? "↗" : (index == 3 ? "ellipse" : (index == 4 ? "freehand" : (index == 5 ? "☁" : "□"))));
                        stacked: true; min-height: 76px; enabled: root.work-mode;
                        clicked => { root.annotation-kind(label); }
                    }
                }
                if root.tab == 4 : VerticalBox {
                    HorizontalBox {
                        alignment: start;
                        Button { text: root.labels[6]; symbol: "layers"; min-height: root.target; clicked => { root.action(6); } }
                        Button { text: root.labels[12]; symbol: "info"; min-height: root.target; clicked => { root.action(12); } }
                        ComboBox { model: root.backends; enabled: root.can-switch-backend; current-index: root.backend-index; min-height: root.target; selected(value) => { root.backend(value); } }
                    }
                    HorizontalBox {
                        alignment: start;
                        for label[index] in root.editing-labels : Button {
                            text: label; symbol: index == 0 ? "line" : (index == 1 ? "circle" : (index == 2 ? "pan" : "trim"));
                            stacked: true; min-height: 76px; enabled: root.work-mode && (index != 3 || root.can-trim);
                            clicked => { root.draw-tool(label); }
                        }
                    }
                }
            }
        }
    }
}
