export global CadTheme {
    out property <brush> chrome: @linear-gradient(90deg, #edf1f5, #d8dfe7);
    out property <color> panel: #e2e7ed;
    out property <color> border: #b5c1ce;
    out property <color> ink: #242e3b;
    out property <color> muted: #637285;
    out property <color> accent: #087dff;
    out property <color> selected: #d0e5ff;
    out property <color> canvas: #1b242b;
}
