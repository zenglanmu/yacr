export global CadTheme {
    // AutoCAD-style dark application frame: dark neutral chrome, light icons,
    // a blue highlight for the active/selected control, and a near-black model
    // space. Kept as one palette so every component restyles together.
    out property <brush> chrome: @linear-gradient(90deg, #3a3a3a, #2e2e2e);
    out property <color> panel: #2b2b2b;
    out property <color> border: #4a4a4a;
    out property <color> ink: #d9d9d9;
    out property <color> muted: #9a9a9a;
    out property <color> accent: #4f9bff;
    out property <color> selected: #2a4d78;
    out property <color> canvas: #1e1e1e;
}
