// Slint composition root. CAD business state is pushed from the Rust adapter.
import { Button, VerticalBox, HorizontalBox, ComboBox, CheckBox, ScrollView, LineEdit } from "std-widgets.slint";
import { CadRibbon } from "ribbon.slint";
import { CadCommandBar } from "command-bar.slint";
import { CadCanvas } from "canvas.slint";
import { CadPanels, LayerRow, PropertyRow, AnnotationRow, DiagnosticRow, LayoutRow } from "panels.slint";
export { LayerRow, PropertyRow, AnnotationRow, DiagnosticRow, LayoutRow } from "panels.slint";
import "../fonts/YacrUI-Regular.otf";


export component YacrWindow inherits Window {
    default-font-family: "Yacr UI";
    default-font-size: 14px;
    min-width: 0px; min-height: 0px;
    out property <length> cad-width: canvas-area.width;
    out property <length> cad-height: canvas-area.height;
    out property <length> cad-top: canvas-area.y;
    in property <string> application-title;
    in property <image> cad-frame;
    in property <string> open-label;
    in property <string> measure-label;
    in property <string> annotate-label;
    in property <string> status-label;
    in property <bool> work-mode;
    in property <string> mode-label;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <int> backend-index;
    in property <string> fit-label;
    in property <string> undo-label;
    in property <string> redo-label;
    in property <string> export-label;
    in property <string> import-label;
    in property <string> diagnostics-label;
    in property <bool> compact-shell;
    in property <bool> phone-shell;
    in property <length> control-height: 40px;
    in property <length> touch-target: 36px;
    in property <length> side-panel-width;
    in property <bool> side-panel-collapsed;
    in property <length> drawer-height;
    in property <bool> show-floating-nav;
    in-out property <bool> side-panel-open;
    in-out property <bool> tools-open;
    in property <string> tools-label;
    in property <string> drawer-label;
    in property <string> nav-label;
    in property <string> view-mode-label;
    in property <string> work-mode-label;
    in property <bool> measurement-active;
    in property <bool> measurement-can-confirm;
    in property <bool> measurement-can-save-annotation;
    in property <int> measurement-kind-index;
    in property <[string]> measurement-kind-labels;
    in property <string> measurement-panel-label;
    in property <string> measure-confirm-label;
    in property <string> measure-cancel-label;
    in property <string> measure-save-label;
    in property <string> measurement-step-label;
    in property <string> unit-label;
    in property <[string]> backend-labels;
    in property <[LayerRow]> layer-rows;
    in property <int> layer-override-count;
    in property <string> layer-override-label;
    in property <string> layer-panel-label;
    in property <string> layer-restore-label;
    in property <string> layer-overridden-marker;
    in property <string> layer-empty-label;
    in property <[PropertyRow]> property-rows;
    in property <string> property-mixed-label;
    in property <string> property-empty-label;
    in property <string> property-panel-label;
    in property <string> property-selected-label;
    in property <string> property-clear-label;
    in property <int> selection-count;
    in property <[AnnotationRow]> annotation-rows;
    in property <int> annotation-hidden-count;
    in property <string> annotation-hidden-label;
    in property <string> annotation-empty-label;
    in property <bool> annotation-tool-active;
    in property <bool> annotation-tool-can-confirm;
    in property <int> annotation-kind-index;
    in property <[string]> annotation-kind-labels;
    in property <string> annotation-panel-label;
    in property <string> annotation-text-placeholder;
    in property <string> annotation-delete-label;
    in property <string> annotate-confirm-label;
    in property <string> annotate-cancel-label;
    in property <string> annotation-step-label;
    in property <bool> annotation-requires-text;
    in property <bool> annotation-text-supplied;
    in-out property <string> annotation-text-input;
    in property <[LayoutRow]> layout-rows;
    in property <int> layout-active-index: -1;
    in property <string> layout-panel-label;
    in property <string> layout-model-space-label;
    in property <string> layout-unsupported-marker;
    in property <string> layout-empty-label;
    in property <bool> view-3d;
    in property <bool> view-perspective;
    in property <string> view-panel-label;
    in property <string> view-2d-label;
    in property <string> view-3d-label;
    in property <string> view-projection-label;
    in property <string> view-ortho-label;
    in property <string> view-perspective-label;
    in property <[string]> standard-view-labels;
    in-out property <bool> diagnostics-open;
    in property <string> diagnostics-drawer-title;
    in property <string> diagnostics-close-label;
    in property <string> diagnostics-backend-label;
    in property <string> diagnostics-summary-label;
    in property <string> diagnostics-empty-label;
    in property <[DiagnosticRow]> diagnostics-rows;
    in property <[string]> ribbon-tabs;
    in property <[string]> editing-labels;
    in property <string> command-title;
    in property <string> command-prompt;
    in property <string> pending-label;
    in-out property <bool> ribbon-expanded: true;
    in-out property <bool> command-expanded: false;
    callback command-submitted(string);
    callback open-requested();
    callback measure-requested();
    callback annotate-requested();
    callback fit-requested();
    callback undo-requested();
    callback redo-requested();
    callback measure-kind-selected(string);
    callback confirm-measurement-requested();
    callback cancel-measurement-requested();
    callback save-measurement-requested();
    callback mode-toggled();
    callback layer-visibility-toggled(int, bool);
    callback restore-layers-requested();
    callback clear-selection-requested();
    callback annotation-kind-selected(string);
    callback confirm-annotation-requested();
    callback cancel-annotation-requested();
    callback annotation-text-edited(string);
    callback annotation-selected(int);
    callback annotation-delete-requested(int);
    callback annotation-visibility-toggled(int, bool);
    callback layout-selected(int);
    callback toggle-view-mode-requested();
    callback toggle-projection-requested();
    callback standard-view-selected(string);
    callback backend-selected(string);
    callback export-requested();
    callback import-requested();
    callback diagnostics-requested();
    callback diagnostics-closed();
    callback pointer-input(int, int, length, length);
    callback scroll-input(float, float);
    callback canvas-pick(float, float);
    title: application-title;
    background: #20242b;
    VerticalBox {
        padding: 0px; spacing: 0px;
        if !root.phone-shell || root.tools-open : CadRibbon {
            phone: root.phone-shell;
            target: root.phone-shell ? 48px : 36px;
            tabs: root.ribbon-tabs;
            labels: [root.open-label, root.fit-label, root.undo-label, root.redo-label,
                root.measure-label, root.annotate-label, root.tools-label, root.view-2d-label,
                root.view-3d-label, root.view-projection-label, root.export-label, root.import-label, root.diagnostics-label];
            standard-views: root.standard-view-labels;
            backends: root.backend-labels;
            backend-index: root.backend-index;
            can-undo: root.work-mode && root.can-undo;
            can-redo: root.work-mode && root.can-redo;
            view-3d: root.view-3d;
            pending-label: root.pending-label;
            editing-labels: root.editing-labels;
            expanded <=> root.ribbon-expanded;
            standard-view(value) => { root.standard-view-selected(value); }
            backend(value) => { root.backend-selected(value); }
            action(id) => {
                if id == 0 { root.open-requested(); }
                if id == 1 { root.fit-requested(); }
                if id == 2 { root.undo-requested(); }
                if id == 3 { root.redo-requested(); }
                if id == 4 { root.measure-requested(); }
                if id == 5 { root.annotate-requested(); }
                if id == 6 { root.side-panel-open = !root.side-panel-open; }
                if (id == 7 && root.view-3d) || (id == 8 && !root.view-3d) { root.toggle-view-mode-requested(); }
                if id == 9 { root.toggle-projection-requested(); }
                if id == 10 { root.export-requested(); }
                if id == 11 { root.import-requested(); }
                if id == 12 { root.diagnostics-open = !root.diagnostics-open; root.diagnostics-requested(); }
            }
        }
        canvas-area := CadCanvas {
            vertical-stretch: 1;
            frame: root.cad-frame;
            pointer(k, b, x, y) => { root.pointer-input(k, b, x, y); }
            scroll(x, y) => { root.scroll-input(x, y); }
            pick(x, y) => { root.canvas-pick(x, y); }
        }
        if root.side-panel-open || root.diagnostics-open : CadPanels {
            phone: root.phone-shell;
            work: root.work-mode;
            labels: [root.layer-panel-label, root.layer-restore-label, root.diagnostics-close-label,
                root.layer-empty-label, root.layout-panel-label, root.layout-model-space-label,
                root.property-panel-label, root.property-clear-label, root.property-empty-label,
                root.annotation-panel-label, root.annotation-empty-label, root.annotation-delete-label,
                root.diagnostics-empty-label];
            layers: root.layer-rows; properties: root.property-rows; layouts: root.layout-rows;
            annotations: root.annotation-rows; diagnostics: root.diagnostics-rows;
            diagnostics-open: root.diagnostics-open; backend: root.diagnostics-backend-label;
            close => { root.side-panel-open = false; root.diagnostics-open = false; root.diagnostics-closed(); }
            restore => { root.restore-layers-requested(); }
            clear-selection => { root.clear-selection-requested(); }
            layer(i, v) => { root.layer-visibility-toggled(i, v); }
            layout(i) => { root.layout-selected(i); }
            annotation-select(i) => { root.annotation-selected(i); }
            annotation-delete(i) => { root.annotation-delete-requested(i); }
            annotation-visible(i, v) => { root.annotation-visibility-toggled(i, v); }
        }
        if root.measurement-active : HorizontalBox {
            height: root.phone-shell ? 56px : 44px;
            ComboBox { model: root.measurement-kind-labels; current-index: root.measurement-kind-index; selected(v) => { root.measure-kind-selected(v); } }
            Button { text: root.measure-confirm-label; enabled: root.measurement-can-confirm; clicked => { root.confirm-measurement-requested(); } }
            Button { text: root.measure-cancel-label; clicked => { root.cancel-measurement-requested(); } }
        }
        if root.measurement-can-save-annotation : HorizontalBox {
            height: root.phone-shell ? 56px : 44px;
            Button { text: root.measure-save-label; min-height: root.phone-shell ? 48px : 36px; clicked => { root.save-measurement-requested(); } }
        }
        if root.annotation-tool-active && root.annotation-requires-text : LineEdit {
            min-height: 48px; placeholder-text: root.annotation-text-placeholder;
            text <=> root.annotation-text-input; edited(v) => { root.annotation-text-edited(v); }
        }
        if root.annotation-tool-active : HorizontalBox {
            height: root.phone-shell ? 56px : 44px;
            ComboBox { model: root.annotation-kind-labels; current-index: root.annotation-kind-index; selected(v) => { root.annotation-kind-selected(v); } }
            Button { text: root.annotate-confirm-label; enabled: root.annotation-tool-can-confirm; clicked => { root.confirm-annotation-requested(); } }
            Button { text: root.annotate-cancel-label; clicked => { root.cancel-annotation-requested(); } }
        }
        CadCommandBar {
            phone: root.phone-shell;
            title: root.command-title;
            prompt: root.command-prompt;
            status: root.status-label;
            open-label: root.open-label;
            fit-label: root.fit-label;
            tools-label: root.tools-label;
            mode-label: root.mode-label;
            mode-work: root.work-mode;
            expanded <=> root.command-expanded;
            open => { root.open-requested(); }
            fit => { root.fit-requested(); }
            tools => { if root.phone-shell { root.tools-open = !root.tools-open; } else { root.side-panel-open = !root.side-panel-open; } }
            mode-toggled => { root.mode-toggled(); }
            submit(value) => { root.command-submitted(value); }
        }
    }
}
