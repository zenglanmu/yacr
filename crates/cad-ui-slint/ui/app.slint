// Candidate shared shell, not platform-validated yet.
import { Button, VerticalBox, HorizontalBox, ComboBox } from "std-widgets.slint";

export component YacrWindow inherits Window {
    in property <string> application-title;
    in property <string> open-label;
    in property <string> measure-label;
    in property <string> annotate-label;
    in property <string> status-label;
    in property <image> cad-frame;
    in property <bool> work-mode;
    in property <string> mode-label: "增强";
    // Undo and redo availability are independent so undoing to empty still
    // permits redo (audit U11); never share the undo flag.
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <int> backend-index: 0;

    // --- Measurement tool panel (audit U03/U04) --------------------------
    // All values are pushed from the application state; the shell invents
    // nothing. `measurement-active` gates the confirm/cancel affordances.
    in property <bool> measurement-active: false;
    in property <bool> measurement-can-confirm: false;
    in property <int> measurement-kind-index: 0;
    in property <string> measurement-step-label: "";
    in property <string> unit-label: "";

    callback open-requested();
    callback measure-requested();
    callback annotate-requested();
    callback fit-requested();
    callback undo-requested();
    callback redo-requested();
    // Label of the chosen model entry; the adapter maps it to the shared
    // MeasurementToolKind::ALL labels so no second ordering list exists.
    callback measure-kind-selected(name: string);
    callback confirm-measurement-requested();
    callback cancel-measurement-requested();
    callback backend-selected(name: string);
    callback export-requested();
    callback import-requested();
    callback diagnostics-requested();
    callback pointer-input(kind: int, button: int, x: length, y: length);
    callback scroll-input(dx: float, dy: float);
    // A single left-button click on the canvas, in logical pixels relative to
    // the image. The adapter turns it into a measurement point when a mapper is
    // installed (see docs/ui.md).
    callback canvas-pick(x: float, y: float);

    title: application-title;
    background: #20242b;

    VerticalBox {
        HorizontalBox {
            spacing: 6px;
            padding: 6px;
            Button { text: root.open-label; clicked => { root.open-requested(); } }
            Button { text: "适应"; clicked => { root.fit-requested(); } }
            Button {
                text: "撤销";
                enabled: root.work-mode && root.can-undo;
                clicked => { root.undo-requested(); }
            }
            Button {
                text: "重做";
                enabled: root.work-mode && root.can-redo;
                clicked => { root.redo-requested(); }
            }
            Button {
                text: root.measure-label;
                enabled: root.work-mode;
                clicked => { root.measure-requested(); }
            }
            Button {
                text: root.annotate-label;
                enabled: root.work-mode;
                clicked => { root.annotate-requested(); }
            }
            ComboBox {
                width: 96px;
                model: ["Auto", "WebGPU", "WebGL2"];
                current-index: root.backend-index;
                selected(value) => { root.backend-selected(value); }
            }
            Button { text: "导出"; clicked => { root.export-requested(); } }
            Button { text: "导入"; clicked => { root.import-requested(); } }
            Button { text: "诊断"; clicked => { root.diagnostics-requested(); } }
        }

        // Compact tool/properties panel. Measurement is the only tool wired so
        // far; other panels are intentionally absent (see docs/ui.md).
        Rectangle {
            height: 40px;
            background: #262b33;
            HorizontalBox {
                spacing: 8px;
                padding: 4px;
                alignment: center;
                Text {
                    text: "测量";
                    color: #c8d0dc;
                    vertical-alignment: center;
                }
                ComboBox {
                    width: 120px;
                    enabled: root.work-mode;
                    // Mirrors MeasurementToolKind::ALL; the adapter owns the
                    // mapping so the two lists cannot drift silently.
                    model: ["距离", "折线长度", "角度", "面积"];
                    current-index: root.measurement-kind-index;
                    selected(value) => { root.measure-kind-selected(value); }
                }
                Button {
                    text: "确认";
                    enabled: root.work-mode && root.measurement-can-confirm;
                    clicked => { root.confirm-measurement-requested(); }
                }
                Button {
                    text: "取消";
                    enabled: root.work-mode && root.measurement-active;
                    clicked => { root.cancel-measurement-requested(); }
                }
                Text {
                    text: root.measurement-step-label;
                    color: #e6edf7;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: root.unit-label;
                    color: #9aa7b8;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            background: #10131a;
            // The CAD frame is produced by the wgpu renderer and shared as a
            // texture; it is composited by Slint, never read back per frame.
            Image {
                source: root.cad-frame;
                image-fit: contain;
            }
            TouchArea {
                // kind: 0=down 1=up 2=move 3=cancel; button: 0=none 1=left 2=right 3=middle
                pointer-event(e) => {
                    root.pointer-input(
                        e.kind == PointerEventKind.down ? 0 :
                        (e.kind == PointerEventKind.up ? 1 :
                        (e.kind == PointerEventKind.move ? 2 : 3)),
                        e.button == PointerEventButton.left ? 1 :
                        (e.button == PointerEventButton.right ? 2 :
                        (e.button == PointerEventButton.middle ? 3 : 0)),
                        self.mouse-x, self.mouse-y);
                    // A completed left click is offered as a measurement pick.
                    if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                        root.canvas-pick(self.mouse-x / 1px, self.mouse-y / 1px);
                    }
                }
                scroll-event(e) => {
                    root.scroll-input(e.delta-x / 1px, e.delta-y / 1px);
                    return EventResult.accept;
                }
            }
        }
        Rectangle {
            height: 28px;
            background: #181c22;
            HorizontalLayout {
                padding-left: 8px;
                alignment: center;
                Text { text: root.status-label; color: white; }
            }
        }
    }
}
