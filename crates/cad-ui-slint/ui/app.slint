// Slint composition root. CAD business state is pushed from the Rust adapter.
import { Button, VerticalBox, HorizontalBox, ComboBox, CheckBox, ScrollView, LineEdit, ProgressIndicator, Palette } from "std-widgets.slint";
import { CadRibbon } from "ribbon.slint";
import { RibbonCommandModel, RibbonGroupModel, RibbonTabModel } from "ribbon-model.slint";
import { CadCommandBar } from "command-bar.slint";
import { CadCanvas } from "canvas.slint";
import { Button as ConceptButton } from "button.slint";
import { CadTheme } from "theme.slint";
import { CadPanels, LayerRow, PropertyRow, AnnotationRow, DiagnosticRow, LayoutRow } from "panels.slint";
export { LayerRow, PropertyRow, AnnotationRow, DiagnosticRow, LayoutRow } from "panels.slint";
export { RibbonCommandModel, RibbonGroupModel, RibbonTabModel } from "ribbon-model.slint";
import "../fonts/YacrUI-Regular.otf";


export component YacrWindow inherits Window {
    default-font-family: "Yacr UI";
    default-font-size: 14px;
    min-width: 0px; min-height: 0px;
    // AutoCAD-style dark frame: make the shared std-widgets (command line,
    // combo boxes, confirm buttons, progress) use the dark Fluent palette
    // instead of the default light one.
    init => { Palette.color-scheme = ColorScheme.dark; }
    out property <length> cad-width: canvas-area.width;
    out property <length> cad-height: canvas-area.height;
    out property <length> cad-top: workspace-area.y + canvas-area.y;
    out property <length> cad-left: workspace-area.x + canvas-area.x;
    in property <bool> application-ui: true;
    // Fail closed until the adapter pushes interaction.keyboardShortcuts from
    // the effective ViewerConfig on initial presentation and every config edit.
    in property <bool> keyboard-shortcuts-enabled: false;
    in property <bool> ribbon-visible: true;
    in property <bool> panels-visible: true;
    in property <bool> layer-panel-visible: true;
    in property <bool> properties-panel-visible: true;
    in property <bool> layer-panel-initially-open: true;
    in property <bool> properties-panel-initially-open: true;
    in property <bool> navigation-visible: true;
    in property <string> pan-label;
    in property <string> zoom-in-label;
    in property <string> zoom-out-label;
    in-out property <bool> pan-active: false;
    in property <bool> can-open: true;
    in property <bool> can-import: true;
    in property <bool> can-export: true;
    in property <bool> can-trim: true;
    in property <bool> can-switch-backend: true;
    callback pan-requested();
    callback zoom-requested(float);
    in property <bool> command-visible: true;
    in property <bool> layouts-visible: true;
    in property <bool> status-visible: true;
    // Effective per-command visibility (features × preset × commandOverrides).
    // Hidden entries are absent; hiding an entry never disables the command.
    in property <bool> cmd-measure-visible: true;
    in property <bool> cmd-annotate-visible: true;
    in property <bool> cmd-annotation-delete-visible: true;
    in property <bool> cmd-export-visible: true;
    in property <bool> cmd-import-visible: true;
    // Data-only readout of the resolved ViewerConfig. Hosts and tests query the
    // effective config without re-deriving it; the shell layout properties above
    // are what the UI renders.
    in property <int> config-revision: 0;
    in property <string> config-preset: "full";
    in property <string> config-effective-json: "{}";
    // Overlay flags are `in-out` so the desktop status-bar toggles reflect the
    // effective config and can emit the flipped value back to the host through
    // `overlay-toggled`. The adapter still re-pushes them from the config store
    // after every config change (see `apply_viewer_presentation_with`), so the
    // store stays the single source of truth; the toggle is never a shadow copy.
    in-out property <bool> overlay-axes: true;
    in-out property <bool> overlay-grid: true;
    in-out property <bool> overlay-selection-highlight: true;
    in-out property <bool> overlay-snap-hints: true;
    in-out property <bool> overlay-annotations: true;
    in property <string> overlay-axes-label;
    in property <string> overlay-grid-label;
    in property <string> overlay-snap-hints-label;
    in property <bool> feature-measure: true;
    in property <bool> feature-annotation-create: true;
    in property <bool> feature-annotation-update: true;
    in property <bool> feature-annotation-delete: true;
    in property <bool> feature-annotation-import: true;
    in property <bool> feature-annotation-export: true;
    in property <string> more-label;
    in property <string> application-title;
    in property <image> cad-frame;
    in property <string> open-label;
    in property <string> measure-label;
    in property <string> annotate-label;
    in property <string> status-label;
    in property <bool> work-mode;
    in property <string> mode-label;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <int> backend-index;
    in property <string> fit-label;
    in property <string> undo-label;
    in property <string> redo-label;
    in property <string> export-label;
    in property <string> import-label;
    in property <string> diagnostics-label;
    in property <bool> compact-shell;
    in property <bool> phone-shell;
    in property <length> control-height: 40px;
    in property <length> touch-target: 36px;
    in property <length> side-panel-width;
    in property <bool> side-panel-collapsed;
    in property <length> drawer-height;
    in property <bool> show-floating-nav;
    in-out property <bool> side-panel-open: !root.phone-shell && !root.compact-shell;
    in-out property <bool> tools-open;
    in property <string> tools-label;
    in property <string> drawer-label;
    in property <string> nav-label;
    in property <string> view-mode-label;
    in property <string> work-mode-label;
    in property <bool> measurement-active;
    in property <bool> measurement-can-confirm;
    in property <bool> measurement-can-save-annotation;
    in property <int> measurement-kind-index;
    in property <[string]> measurement-kind-labels;
    in property <string> measurement-panel-label;
    in property <string> measure-confirm-label;
    in property <string> measure-cancel-label;
    in property <string> measure-save-label;
    in property <string> measurement-step-label;
    in property <string> unit-label;
    in property <[string]> backend-labels;
    in property <[LayerRow]> layer-rows;
    in property <int> layer-override-count;
    in property <string> layer-override-label;
    in property <string> layer-panel-label;
    in property <string> layer-restore-label;
    in property <string> layer-overridden-marker;
    in property <string> layer-empty-label;
    in property <string> layer-search-placeholder;
    in property <string> layer-search-clear-label;
    in property <string> layer-search-empty-label;
    in-out property <string> layer-search-text;
    in property <int> layer-matching-count: 0;
    callback layer-search-edited(string);
    changed layer-search-text => { root.layer-search-edited(root.layer-search-text); }
    in property <[PropertyRow]> property-rows;
    in property <string> property-mixed-label;
    in property <string> property-empty-label;
    in property <string> property-panel-label;
    in property <string> property-selected-label;
    in property <string> property-clear-label;
    in property <int> selection-count;
    in property <[AnnotationRow]> annotation-rows;
    in property <int> annotation-hidden-count;
    in property <string> annotation-hidden-label;
    in property <string> annotation-empty-label;
    in property <bool> annotation-tool-active;
    in property <bool> annotation-tool-can-confirm;
    in property <int> annotation-kind-index;
    in property <[string]> annotation-kind-labels;
    in property <string> annotation-panel-label;
    in property <string> annotation-text-placeholder;
    in property <string> annotation-delete-label;
    in property <string> annotate-confirm-label;
    in property <string> annotate-cancel-label;
    in property <string> annotation-step-label;
    in property <bool> annotation-requires-text;
    in property <bool> annotation-text-supplied;
    in-out property <string> annotation-text-input;
    in property <[LayoutRow]> layout-rows;
    in property <[string]> layout-labels;
    in property <int> layout-active-index: -1;
    in property <string> layout-panel-label;
    in property <string> layout-model-space-label;
    in property <string> layout-unsupported-marker;
    in property <string> layout-empty-label;
    in property <bool> view-3d;
    in property <bool> view-perspective;
    in property <string> view-panel-label;
    in property <string> view-2d-label;
    in property <string> view-3d-label;
    in property <string> view-projection-label;
    in property <string> view-ortho-label;
    in property <string> view-perspective-label;
    in property <[string]> standard-view-labels;
    in-out property <bool> diagnostics-open;
    in property <string> diagnostics-drawer-title;
    in property <string> diagnostics-close-label;
    in property <string> diagnostics-backend-label;
    in property <string> diagnostics-summary-label;
    in property <string> diagnostics-empty-label;
    in property <[DiagnosticRow]> diagnostics-rows;
    in property <bool> import-active;
    in property <string> import-phase-label;
    in property <string> import-progress-text;
    in property <float> import-percent;
    in property <bool> import-indeterminate;
    in property <bool> import-cancellable;
    in property <string> import-panel-label;
    in property <string> import-cancel-label;
    in property <[string]> ribbon-tabs;
    in property <[RibbonTabModel]> ribbon-config-tabs;
    in property <bool> ribbon-config-driven: false;
    in property <[string]> editing-labels;
    in property <string> command-title;
    in property <string> command-prompt;
    in property <string> draw-status;
    in property <bool> draw-tool-active;
    in property <bool> draw-can-confirm;
    in property <string> draw-step-label;
    in property <string> draw-confirm-label;
    in property <string> draw-cancel-label;
    in-out property <bool> ribbon-expanded: true;
    in-out property <int> ribbon-tab: 2;
    in-out property <bool> command-expanded: false;
    callback command-submitted(string);
    callback open-requested();
    callback measure-requested();
    callback annotate-requested();
    callback begin-draw-tool(string);
    callback ribbon-command(string);
    callback confirm-draw-requested();
    callback cancel-draw-requested();
    callback fit-requested();
    callback undo-requested();
    callback redo-requested();
    callback measure-kind-selected(string);
    callback confirm-measurement-requested();
    callback cancel-measurement-requested();
    callback save-measurement-requested();
    callback mode-toggled();
    callback layer-visibility-toggled(int, bool);
    callback restore-layers-requested();
    callback clear-selection-requested();
    callback annotation-kind-selected(string);
    callback confirm-annotation-requested();
    callback cancel-annotation-requested();
    callback annotation-text-edited(string);
    callback annotation-selected(int);
    callback annotation-delete-requested(int);
    callback annotation-visibility-toggled(int, bool);
    callback layout-selected(int);
    // Desktop status-bar overlay toggles: the overlay key ("axes"/"grid"/
    // "snapHints"/"selectionHighlight"/"annotations") plus the new value.
    callback overlay-toggled(string, bool);
    callback toggle-view-mode-requested();
    callback toggle-projection-requested();
    callback standard-view-selected(string);
    callback backend-selected(string);
    callback export-requested();
    callback import-requested();
    callback diagnostics-requested();
    callback diagnostics-closed();
    callback cancel-open-requested();
    callback pointer-input(int, int, length, length);
    callback scroll-input(float, float);
    callback canvas-pick(float, float);
    title: application-title;
    background: CadTheme.canvas;
    forward-focus: shortcut-scope;
    // Cancel only the highest-priority live interaction. State stays owned by
    // the existing host callbacks; Escape never fabricates a successful edit.
    function cancel-interaction() -> bool {
        if root.import-active {
            if root.import-cancellable { root.cancel-open-requested(); }
            return true;
        }
        if root.draw-tool-active { root.cancel-draw-requested(); return true; }
        if root.annotation-tool-active { root.cancel-annotation-requested(); return true; }
        if root.measurement-active { root.cancel-measurement-requested(); return true; }
        if root.pan-active { root.pan-requested(); return true; }
        if root.diagnostics-open {
            root.diagnostics-open = false;
            root.diagnostics-closed();
            return true;
        }
        if root.tools-open { root.tools-open = false; return true; }
        if root.selection-count > 0 { root.clear-selection-requested(); return true; }
        return false;
    }
    shortcut-scope := FocusScope {
        width: parent.width; height: parent.height;
        // Capture only non-editing global keys. Text widgets retain clipboard,
        // caret movement, character input and their own undo/redo history.
        capture-key-pressed(event) => {
            if !root.application-ui || !root.keyboard-shortcuts-enabled {
                return EventResult.reject;
            }
            if event.modifiers.alt || event.modifiers.meta { return EventResult.reject; }
            if event.modifiers.control && !event.modifiers.shift
                && (event.text == "o" || event.text == "O") && root.can-open {
                root.open-requested();
                return EventResult.accept;
            }
            if !event.modifiers.control && !event.modifiers.shift {
                if event.text == Key.F2 && root.command-visible {
                    // This expands the existing command/status row, not a
                    // nonexistent full command-history browser.
                    root.command-expanded = !root.command-expanded;
                    return EventResult.accept;
                }
                if event.text == Key.Escape && root.cancel-interaction() {
                    return EventResult.accept;
                }
            }
            return EventResult.reject;
        }
        // Bubbled events only: a focused LineEdit gets first refusal for its
        // local undo/redo and Ctrl+Home. Disabled/unimplemented actions reject.
        key-pressed(event) => {
            if !root.application-ui || !root.keyboard-shortcuts-enabled
                || event.modifiers.alt || event.modifiers.meta || !event.modifiers.control {
                return EventResult.reject;
            }
            if (event.text == "z" || event.text == "Z") && root.work-mode {
                if event.modifiers.shift && root.can-redo {
                    root.redo-requested(); return EventResult.accept;
                }
                if !event.modifiers.shift && root.can-undo {
                    root.undo-requested(); return EventResult.accept;
                }
            }
            if !event.modifiers.shift && (event.text == "y" || event.text == "Y")
                && root.work-mode && root.can-redo {
                root.redo-requested(); return EventResult.accept;
            }
            if !event.modifiers.shift && event.text == Key.Home {
                root.fit-requested(); return EventResult.accept;
            }
            return EventResult.reject;
        }
    VerticalBox {
        padding: 0px; spacing: 0px;
        if root.application-ui : Rectangle {
            height: root.phone-shell ? 52px : 36px;
            background: CadTheme.chrome;
            HorizontalBox {
                padding: 4px; spacing: 4px;
                ConceptButton { text: root.open-label; symbol: "▱"; icon-only: true; enabled: root.can-open;
                    min-width: 48px; preferred-width: 48px; min-height: root.phone-shell ? 44px : 28px;
                    clicked => { root.open-requested(); } }
                if !root.phone-shell : ConceptButton { text: root.undo-label; symbol: "↶"; icon-only: true;
                    min-width: 36px; preferred-width: 36px; min-height: 28px;
                    enabled: root.work-mode && root.can-undo; clicked => { root.undo-requested(); } }
                if !root.phone-shell : ConceptButton { text: root.redo-label; symbol: "↷"; icon-only: true;
                    min-width: 36px; preferred-width: 36px; min-height: 28px;
                    enabled: root.work-mode && root.can-redo; clicked => { root.redo-requested(); } }
                Text { text: root.application-title; color: CadTheme.ink; font-size: root.phone-shell ? 18px : 15px;
                    horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                if root.cmd-export-visible : ConceptButton { text: root.export-label; symbol: "⇧"; icon-only: true; enabled: root.can-export;
                    min-width: 36px; preferred-width: 36px; min-height: 28px;
                    clicked => { root.export-requested(); } }
                if root.cmd-import-visible : ConceptButton { text: root.import-label; symbol: "⇩"; icon-only: true; enabled: root.can-import && root.work-mode;
                    min-width: 36px; preferred-width: 36px; min-height: 28px;
                    clicked => { root.import-requested(); } }
                ConceptButton { text: root.more-label; symbol: "···"; icon-only: true;
                    min-width: 48px; preferred-width: 48px; min-height: root.phone-shell ? 44px : 28px;
                    clicked => { root.tools-open = !root.tools-open; root.ribbon-expanded = true; root.ribbon-tab = 4; } }
            }
        }
        if root.application-ui && root.ribbon-visible && !root.phone-shell : CadRibbon {
            phone: root.phone-shell;
            compact: root.compact-shell;
            target: root.phone-shell ? 48px : 36px;
            tabs: root.ribbon-tabs;
            measurements: root.measurement-kind-labels;
            annotations: root.annotation-kind-labels;
            labels: [root.open-label, root.fit-label, root.undo-label, root.redo-label,
                root.measure-label, root.annotate-label, root.tools-label, root.view-2d-label,
                root.view-3d-label, root.view-projection-label, root.export-label, root.import-label, root.diagnostics-label];
            standard-views: root.standard-view-labels;
            backends: root.backend-labels;
            backend-index: root.backend-index;
            can-undo: root.work-mode && root.can-undo;
            can-redo: root.work-mode && root.can-redo;
            view-3d: root.view-3d;
            work-mode: root.work-mode;
            can-open: root.can-open; can-import: root.can-import; can-export: root.can-export;
            can-trim: root.can-trim; can-switch-backend: root.can-switch-backend;
            draw-status: root.draw-status;
            editing-labels: root.editing-labels;
            config-tabs: root.ribbon-config-tabs;
            config-driven: root.ribbon-config-driven;
            overflow-label: root.more-label;
            expanded <=> root.ribbon-expanded;
            tab <=> root.ribbon-tab;
            measure-kind(value) => { root.measure-kind-selected(value); }
            annotation-kind(value) => { root.annotation-kind-selected(value); }
            standard-view(value) => { root.standard-view-selected(value); }
            backend(value) => { root.backend-selected(value); }
            draw-tool(value) => { root.begin-draw-tool(value); }
            ribbon-command(id) => { root.ribbon-command(id); }
            action(id) => {
                if id == 0 { root.open-requested(); }
                if id == 1 { root.fit-requested(); }
                if id == 2 { root.undo-requested(); }
                if id == 3 { root.redo-requested(); }
                if id == 4 { root.measure-requested(); }
                if id == 5 { root.annotate-requested(); }
                if id == 6 { root.side-panel-open = !root.side-panel-open; }
                if (id == 7 && root.view-3d) || (id == 8 && !root.view-3d) { root.toggle-view-mode-requested(); }
                if id == 9 { root.toggle-projection-requested(); }
                if id == 10 { root.export-requested(); }
                if id == 11 { root.import-requested(); }
                if id == 12 { root.diagnostics-open = !root.diagnostics-open; root.diagnostics-requested(); }
            }
        }
        workspace-area := HorizontalBox {
            padding: 0px; spacing: 0px;
            vertical-stretch: 1;
        if root.application-ui && root.panels-visible && !root.phone-shell && (root.side-panel-open || root.diagnostics-open) : CadPanels {
            width: 240px; vertical-stretch: 1;
            phone: root.phone-shell;
            work: root.work-mode;
            labels: [root.layer-panel-label, root.layer-restore-label, root.diagnostics-close-label,
                root.layer-empty-label, root.layout-panel-label, root.layout-model-space-label,
                root.property-panel-label, root.property-clear-label, root.property-empty-label,
                root.annotation-panel-label, root.annotation-empty-label, root.annotation-delete-label,
                root.diagnostics-empty-label];
            layers: root.layer-rows; properties: root.property-rows; layouts: root.layout-rows;
            layer-search-text <=> root.layer-search-text;
            layer-search-placeholder: root.layer-search-placeholder;
            layer-search-clear-label: root.layer-search-clear-label;
            layer-search-empty-label: root.layer-search-empty-label;
            layer-matching-count: root.layer-matching-count;
            annotations: root.annotation-rows; diagnostics: root.diagnostics-rows;
            diagnostics-open: root.diagnostics-open; backend: root.diagnostics-backend-label;
            close => { root.side-panel-open = false; root.diagnostics-open = false; root.diagnostics-closed(); }
            restore => { root.restore-layers-requested(); }
            clear-selection => { root.clear-selection-requested(); }
            layer(i, v) => { root.layer-visibility-toggled(i, v); }
            layout(i) => { root.layout-selected(i); }
            annotation-select(i) => { root.annotation-selected(i); }
            annotation-delete(i) => { root.annotation-delete-requested(i); }
            annotation-visible(i, v) => { root.annotation-visibility-toggled(i, v); }
        }
        canvas-area := Rectangle {
            horizontal-stretch: 1; min-width: 0px; min-height: 0px; clip: true;
            CadCanvas {
                width: parent.width; height: parent.height;
                frame: root.cad-frame;
                pointer(k, b, x, y) => {
                    if k == 0 { shortcut-scope.focus(); }
                    root.pointer-input(k, b, x, y);
                }
                scroll(x, y) => { root.scroll-input(x, y); }
                pick(x, y) => { root.canvas-pick(x, y); }
            }
            if root.application-ui && root.navigation-visible : Rectangle {
                x: parent.width - 64px; y: 20px; width: 48px; height: 192px;
                border-radius: 8px; border-width: 1px; border-color: #5a5a5a; background: #2b2b2bdd;
                ConceptButton { y: 0px; text: root.fit-label; symbol: "⊡"; foreground: #d9d9d9; icon-only: true; width: 48px; height: 48px;
                    clicked => { root.fit-requested(); } }
                ConceptButton { y: 48px; text: root.pan-label; symbol: "pan"; checked: root.pan-active; foreground: #d9d9d9; icon-only: true; width: 48px; height: 48px;
                    clicked => { root.pan-requested(); } }
                ConceptButton { y: 96px; text: root.zoom-in-label; symbol: "zoom-in"; foreground: #d9d9d9; icon-only: true; width: 48px; height: 48px;
                    clicked => { root.zoom-requested(1.25); } }
                ConceptButton { y: 144px; text: root.zoom-out-label; symbol: "zoom-out"; foreground: #d9d9d9; icon-only: true; width: 48px; height: 48px;
                    clicked => { root.zoom-requested(0.8); } }
            }
            if root.application-ui && root.layouts-visible && root.phone-shell : ComboBox {
                x: 12px; y: 16px; width: 140px; height: 48px;
                model: root.layout-labels; current-index: root.layout-active-index + 1;
                selected(value) => { root.layout-selected(self.current-index - 1); }
            }
        }
        }
        if root.application-ui && root.panels-visible && root.phone-shell && (root.side-panel-open || root.diagnostics-open) : CadPanels {
            height: 240px; phone: true; work: root.work-mode;
            labels: [root.layer-panel-label, root.layer-restore-label, root.diagnostics-close-label,
                root.layer-empty-label, root.layout-panel-label, root.layout-model-space-label,
                root.property-panel-label, root.property-clear-label, root.property-empty-label,
                root.annotation-panel-label, root.annotation-empty-label, root.annotation-delete-label,
                root.diagnostics-empty-label];
            layers: root.layer-rows; properties: root.property-rows; layouts: root.layout-rows;
            layer-search-text <=> root.layer-search-text;
            layer-search-placeholder: root.layer-search-placeholder;
            layer-search-clear-label: root.layer-search-clear-label;
            layer-search-empty-label: root.layer-search-empty-label;
            layer-matching-count: root.layer-matching-count;
            annotations: root.annotation-rows; diagnostics: root.diagnostics-rows;
            diagnostics-open: root.diagnostics-open; backend: root.diagnostics-backend-label;
            close => { root.side-panel-open = false; root.diagnostics-open = false; root.diagnostics-closed(); }
            restore => { root.restore-layers-requested(); }
            clear-selection => { root.clear-selection-requested(); }
            layer(i, v) => { root.layer-visibility-toggled(i, v); }
            layout(i) => { root.layout-selected(i); }
            annotation-select(i) => { root.annotation-selected(i); }
            annotation-delete(i) => { root.annotation-delete-requested(i); }
            annotation-visible(i, v) => { root.annotation-visibility-toggled(i, v); }
        }
        if root.application-ui && root.measurement-active : HorizontalBox {
            height: root.phone-shell ? 56px : 44px;
            ComboBox { model: root.measurement-kind-labels; current-index: root.measurement-kind-index; selected(v) => { root.measure-kind-selected(v); } }
            Button { text: root.measure-confirm-label; enabled: root.measurement-can-confirm; clicked => { root.confirm-measurement-requested(); } }
            Button { text: root.measure-cancel-label; clicked => { root.cancel-measurement-requested(); } }
        }
        if root.application-ui && root.measurement-can-save-annotation : HorizontalBox {
            height: root.phone-shell ? 56px : 44px;
            Button { text: root.measure-save-label; min-height: root.phone-shell ? 48px : 36px; clicked => { root.save-measurement-requested(); } }
        }
        if root.application-ui && root.annotation-tool-active && root.annotation-requires-text : LineEdit {
            min-height: 48px; placeholder-text: root.annotation-text-placeholder;
            text <=> root.annotation-text-input; edited(v) => { root.annotation-text-edited(v); }
        }
        if root.application-ui && root.annotation-tool-active : HorizontalBox {
            height: root.phone-shell ? 56px : 44px;
            ComboBox { model: root.annotation-kind-labels; current-index: root.annotation-kind-index; selected(v) => { root.annotation-kind-selected(v); } }
            Button { text: root.annotate-confirm-label; enabled: root.annotation-tool-can-confirm; clicked => { root.confirm-annotation-requested(); } }
            Button { text: root.annotate-cancel-label; clicked => { root.cancel-annotation-requested(); } }
        }
        if root.application-ui && root.draw-tool-active : HorizontalBox {
            height: root.phone-shell ? 56px : 44px;
            Text { text: root.draw-step-label; color: #c8d0dc; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            Button { text: root.draw-confirm-label; enabled: root.draw-can-confirm; min-height: root.phone-shell ? 48px : 36px; clicked => { root.confirm-draw-requested(); } }
            Button { text: root.draw-cancel-label; min-height: root.phone-shell ? 48px : 36px; clicked => { root.cancel-draw-requested(); } }
        }
        // Asynchronous open progress (F01). Hidden while idle; shows a real
        // percent only when the importer reported a total, otherwise an
        // indeterminate bar.
        if root.application-ui && root.import-active : HorizontalBox {
            height: root.phone-shell ? 56px : 44px;
            Text { text: root.import-phase-label; color: #c8d0dc; vertical-alignment: center; }
            ProgressIndicator {
                horizontal-stretch: 1;
                progress: root.import-percent;
                indeterminate: root.import-indeterminate;
            }
            Text { text: root.import-progress-text; color: #9aa7b8; vertical-alignment: center; }
            Button {
                text: root.import-cancel-label;
                enabled: root.import-cancellable;
                clicked => { root.cancel-open-requested(); }
            }
        }
        if root.application-ui && root.command-visible && (!root.phone-shell || root.command-expanded) : CadCommandBar {
            phone: root.phone-shell;
            title: root.command-title;
            prompt: root.command-prompt;
            status: root.status-label;
            open-label: root.open-label;
            can-open: root.can-open;
            fit-label: root.fit-label;
            tools-label: root.tools-label;
            mode-label: root.mode-label;
            mode-work: root.work-mode;
            expanded <=> root.command-expanded;
            open => { root.open-requested(); }
            fit => { root.fit-requested(); }
            tools => { if root.phone-shell { root.tools-open = !root.tools-open; } else { root.side-panel-open = !root.side-panel-open; } }
            mode-toggled => { root.mode-toggled(); }
            submit(value) => { root.command-submitted(value); }
        }
        if root.application-ui && root.layouts-visible && !root.phone-shell : Rectangle {
            height: 36px; background: CadTheme.chrome;
            ScrollView {
                HorizontalBox {
                    padding: 0px; spacing: 0px; alignment: start;
                    ConceptButton { text: root.layout-model-space-label; checked: root.layout-active-index < 0;
                        min-height: 36px; clicked => { root.layout-selected(-1); } }
                    for row[index] in root.layout-rows : ConceptButton {
                        text: row.name; checked: root.layout-active-index == index; enabled: row.supported;
                        min-height: 36px; clicked => { root.layout-selected(index); }
                    }
                }
            }
        }
        if root.application-ui && root.status-visible && !root.phone-shell : Rectangle {
            height: 26px; background: CadTheme.chrome;
            HorizontalBox {
                padding: 0px; padding-left: 12px; padding-right: 4px; spacing: 2px;
                Text { text: root.status-label; color: CadTheme.muted; horizontal-stretch: 1;
                    font-size: 12px; vertical-alignment: center; overflow: elide; }
                // Desktop overlay toggles. Labels come from the catalog so the
                // accessible text is localized and never a hardcoded literal.
                ConceptButton { text: root.overlay-axes-label; symbol: "╋"; icon-only: true; checked: root.overlay-axes;
                    min-width: 30px; preferred-width: 30px; min-height: 24px; preferred-height: 24px;
                    clicked => { root.overlay-toggled("axes", !root.overlay-axes); } }
                ConceptButton { text: root.overlay-grid-label; symbol: "▦"; icon-only: true; checked: root.overlay-grid;
                    min-width: 30px; preferred-width: 30px; min-height: 24px; preferred-height: 24px;
                    clicked => { root.overlay-toggled("grid", !root.overlay-grid); } }
                ConceptButton { text: root.overlay-snap-hints-label; symbol: "◎"; icon-only: true; checked: root.overlay-snap-hints;
                    min-width: 30px; preferred-width: 30px; min-height: 24px; preferred-height: 24px;
                    clicked => { root.overlay-toggled("snapHints", !root.overlay-snap-hints); } }
            }
        }
        if root.application-ui && root.ribbon-visible && root.phone-shell && root.tools-open : CadRibbon {
            phone: true; target: 48px; expanded: true; tab <=> root.ribbon-tab;
            tabs: root.ribbon-tabs;
            labels: [root.open-label, root.fit-label, root.undo-label, root.redo-label,
                root.measure-label, root.annotate-label, root.tools-label, root.view-2d-label,
                root.view-3d-label, root.view-projection-label, root.export-label, root.import-label, root.diagnostics-label];
            measurements: root.measurement-kind-labels; annotations: root.annotation-kind-labels;
            standard-views: root.standard-view-labels; backends: root.backend-labels;
            backend-index: root.backend-index; view-3d: root.view-3d; work-mode: root.work-mode;
            can-open: root.can-open; can-import: root.can-import; can-export: root.can-export;
            can-trim: root.can-trim; can-switch-backend: root.can-switch-backend;
            editing-labels: root.editing-labels; draw-status: root.draw-status;
            config-tabs: root.ribbon-config-tabs; config-driven: root.ribbon-config-driven;
            overflow-label: root.more-label;
            can-undo: root.work-mode && root.can-undo; can-redo: root.work-mode && root.can-redo;
            measure-kind(value) => { root.measure-kind-selected(value); }
            annotation-kind(value) => { root.annotation-kind-selected(value); }
            standard-view(value) => { root.standard-view-selected(value); }
            backend(value) => { root.backend-selected(value); }
            draw-tool(value) => { root.begin-draw-tool(value); }
            ribbon-command(id) => { root.ribbon-command(id); }
            action(id) => {
                if id == 0 { root.open-requested(); }
                if id == 1 { root.fit-requested(); }
                if id == 2 { root.undo-requested(); }
                if id == 3 { root.redo-requested(); }
                if id == 6 { root.side-panel-open = !root.side-panel-open; }
                if (id == 7 && root.view-3d) || (id == 8 && !root.view-3d) { root.toggle-view-mode-requested(); }
                if id == 9 { root.toggle-projection-requested(); }
                if id == 10 { root.export-requested(); }
                if id == 11 { root.import-requested(); }
                if id == 12 { root.diagnostics-open = !root.diagnostics-open; root.diagnostics-requested(); }
            }
        }
        // Phone/compact layout strip. The desktop tabs below are hidden on a
        // phone, so the drawer (opened by the bottom "more" entry) must carry
        // the same real `layout-rows` list: model space plus one button per
        // pushed layout, with the active row checked. The list stays short to
        // respect the drawer height budget; an explicit pushed empty label is
        // shown when the host has no layouts yet.
        if root.application-ui && root.phone-shell && root.tools-open && root.layouts-visible : Rectangle {
            height: 52px; background: CadTheme.chrome;
            ScrollView {
                HorizontalBox {
                    padding: 4px; spacing: 4px; alignment: start;
                    ConceptButton { text: root.layout-model-space-label; checked: root.layout-active-index < 0;
                        min-height: 44px; preferred-height: 44px; clicked => { root.layout-selected(-1); } }
                    for row[index] in root.layout-rows : ConceptButton {
                        text: row.name; checked: root.layout-active-index == index; enabled: row.supported;
                        min-height: 44px; preferred-height: 44px; clicked => { root.layout-selected(index); }
                    }
                    if root.layout-rows.length == 0 : Text {
                        vertical-alignment: center; color: CadTheme.muted;
                        text: root.layout-empty-label; overflow: elide;
                    }
                }
            }
        }
        if root.application-ui && root.phone-shell : Rectangle {
            height: 76px; background: CadTheme.chrome;
            HorizontalBox {
                padding: 4px; spacing: 0px;
                ConceptButton { text: root.layer-panel-label; symbol: "layers"; stacked: true; min-width: 0px; horizontal-stretch: 1;
                    min-height: 64px; checked: root.side-panel-open;
                    clicked => { root.side-panel-open = !root.side-panel-open; } }
                if root.cmd-measure-visible : ConceptButton { text: root.measure-label; symbol: "↔"; stacked: true; min-width: 0px; horizontal-stretch: 1;
                    min-height: 64px; checked: root.tools-open && root.ribbon-tab == 2;
                    clicked => { root.ribbon-tab = 2; root.ribbon-expanded = true; root.tools-open = !root.tools-open; } }
                if root.cmd-annotate-visible : ConceptButton { text: root.annotate-label; symbol: "□"; stacked: true; min-width: 0px; horizontal-stretch: 1;
                    min-height: 64px; checked: root.tools-open && root.ribbon-tab == 3;
                    clicked => { root.ribbon-tab = 3; root.ribbon-expanded = true; root.tools-open = !root.tools-open; } }
                ConceptButton { text: root.more-label; symbol: "···"; stacked: true; min-width: 0px; horizontal-stretch: 1;
                    min-height: 64px; clicked => { root.command-expanded = !root.command-expanded; } }
            }
        }
    }
    }
}
