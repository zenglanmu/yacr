{
  "name": "yacr-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vite build",
    "build:web": "YACR_RUNTIME=web vite build --outDir ../app-web/dist-ui --emptyOutDir",
    "build:android": "YACR_RUNTIME=android vite build --outDir ../app-android/dist --emptyOutDir",
    "build:canvas-wasm": "bash ../../scripts/build-canvas-wasm.sh",
    "test": "tsc --noEmit && node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
