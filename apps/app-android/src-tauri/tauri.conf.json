{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yacr",
  "version": "0.1.13",
  "identifier": "io.github.zenglanmu.yacr",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "bash ../../scripts/build-android-ui.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yacr",
        "width": 1024,
        "height": 768,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://yacr.pages.dev; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "android": {
      "minSdkVersion": 24
    },
    "fileAssociations": [
      {
        "ext": ["dwg"],
        "mimeType": "image/vnd.dwg",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["dwg"],
        "mimeType": "application/acad",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["dwg"],
        "mimeType": "application/dwg",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["dwg"],
        "mimeType": "application/x-dwg",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["dwg"],
        "mimeType": "application/autocad_dwg",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["dxf"],
        "mimeType": "image/vnd.dxf",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["dxf"],
        "mimeType": "application/dxf",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["obj"],
        "mimeType": "model/obj",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["stl"],
        "mimeType": "model/stl",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["ply"],
        "mimeType": "model/ply",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["ply"],
        "mimeType": "application/x-ply",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["off"],
        "mimeType": "model/off",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["coff"],
        "mimeType": "application/x-geomview-coff",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["step", "stp"],
        "mimeType": "model/step",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["step", "stp"],
        "mimeType": "application/step",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["ifc"],
        "mimeType": "application/x-ifc",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["rvt"],
        "mimeType": "application/x-revit",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["rte"],
        "mimeType": "application/x-revit-template",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["rfa"],
        "mimeType": "application/x-revit-family",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["rft"],
        "mimeType": "application/x-revit-family-template",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": ["skp"],
        "mimeType": "application/vnd.sketchup.skp",
        "androidIntentActionFilters": ["view"]
      },
      {
        "ext": [
          "dwg",
          "dxf",
          "obj",
          "stl",
          "ply",
          "off",
          "coff",
          "step",
          "stp",
          "ifc",
          "rvt",
          "rte",
          "rfa",
          "rft",
          "skp"
        ],
        "mimeType": "application/octet-stream",
        "androidIntentActionFilters": ["view"]
      }
    ],
    "icon": ["icons/icon.png"]
  }
}
