/target
**/*.rs.bk
*.apk
*.aab
.gradle/
build/
node_modules/
dist/
/web-dist/
/linux-app-evidence/
/linux-app.log
*.keystore
*.jks
keystore.properties
.local/

# Cloudflare Pages/Wrangler local state (scripts/deploy-cloudflare-pages.sh)
.wrangler/

# Bundled CAD fonts are third-party and not committed; assemble them with
# scripts/fetch-fonts.sh (see fonts/SOURCE.md and docs/fonts.md). Hosts keep them
# outside the repository tree (the retired Android APK asset package that used to
# live in apps/app-android/assets is gone with the cargo-apk pipeline).

# Android host (apps/app-android): the Tauri CLI/Gradle state and the generated
# Rust library are local build outputs. The Gradle project itself
# (apps/app-android/src-tauri/gen/android) IS committed — regenerating it is
# CLI-version sensitive, and CI must be able to point at the exact glue.
apps/app-android/dist/
apps/app-android/node_modules/
apps/app-android/src-tauri/gen/android/.gradle/
apps/app-android/src-tauri/gen/android/build/
apps/app-android/src-tauri/gen/android/app/build/
apps/app-android/src-tauri/gen/android/local.properties
apps/app-android/src-tauri/gen/android/**/local.properties
apps/app-android/src-tauri/gen/android/.idea/
apps/app-android/src-tauri/gen/android/*.iml
apps/app-android/src-tauri/gen/android/**/*.iml
apps/app-android/src-tauri/gen/android/app/src/main/jniLibs/
# Tauri's generated ACL/capability schemas are build output of `tauri-build` (and
# regenerate on a CLI bump); the Gradle project above is the part that must be
# reproducible, so only that is committed.
apps/app-android/src-tauri/gen/schemas/

# CLI plot default output written next to the input
*.plot.png
*.plot.svg
*.plot.pdf

# Local deepwork progress (not project artifacts)
.slim/deepwork/
.opencode/

# DOM-canvas wasm artifacts: generated by wasm-bindgen from the pinned toolchain
# and served at the frontend dist root as `/canvas/app_web.js` (+ `_bg.wasm`).
# Never committed. `apps/app-web/web/pkg/` is the same `--target web` output for
# the standalone browser shell, and `apps/app-web/dist/` is the deployable bundle
# both `scripts/build-web.sh` writes.
apps/desktop-ui/public/canvas/
apps/app-web/web/pkg/
apps/app-web/dist/
apps/app-web/dist-ui/

fixtures/complex-test.dwg
fixtures/debug-default-fonts.dwg

# Loop-command scratch state (session-local, never committed)
loop.txt
