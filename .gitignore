# DOM-canvas wasm artifacts: generated by wasm-bindgen from the pinned toolchain
# and served at the frontend dist root as `/canvas/app_web.js` (+ `_bg.wasm`).
# Never committed. `apps/app-web/web/pkg/` is the same `--target web` output for
# the standalone browser shell, and `apps/app-web/dist/` is the deployable bundle
# both `scripts/build-web.sh` writes.
apps/desktop-ui/public/canvas/
apps/app-web/web/pkg/
apps/app-web/dist/

